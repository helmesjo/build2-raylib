# Uncomment to suppress warnings coming from external libraries.
#
#c.internal.scope = current

using c

h{*}: extension = h
c{*}: extension = c

# Interactive GUI demos: do not run as automated tests.
# Also disable install to not deal with target paths, resources etc.
#
exe{*}:
{
  test    = false
  install = false
}

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $c.target
