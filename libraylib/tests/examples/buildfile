# Prefer the static library for examples. Several demos compile raygui with
# RAYGUI_IMPLEMENTATION. Linking the shared libraylib would export
# USE_LIBTYPE_SHARED (for RLAPI dllimport), which makes raygui declare the same
# symbols as dllimport while defining them in the TU (MSVC C4273).
#
import libs = libraylib%liba{raylib}

# Interactive GUI demos: compile to validate the public API, but do not run
# them as automated tests (they open windows and expect user input).
#
exe{*}: test = false

# Categories gated by optional modules (defaults match config.libraylib.*).
#
# Each category is a real directory on the build2 side with per-file source
# symlinks and a package-side leaf resources/ symlink. Binaries are built into
# the category directory so CWD-relative "resources/..." paths match upstream.
#
# fsdir{resources} is always a prerequisite (unique per category).
#
example_dirs =

for t: dir{core others shaders                      \
    ($config.libraylib.module_audio    ? audio:)    \
    ($config.libraylib.module_models   ? models:)   \
    ($config.libraylib.module_shapes   ? shapes:)   \
    ($config.libraylib.module_text     ? text:)     \
    ($config.libraylib.module_textures ? textures:) \
  }
{
  d = $name($t)
  for t: $d/c{* -rlgl_standalone -raylib_opengl_interop}
  {
    n = $name($t)
    ./: $d/exe{$n}: $t $libs $d/fsdir{resources}
  }
}
