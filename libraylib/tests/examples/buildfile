# Link against the static library. Several demos compile raygui with
# RAYGUI_IMPLEMENTATION; the shared library's USE_LIBTYPE_SHARED exports RLAPI
# as dllimport, conflicting with the in-TU definition (MSVC C4273).
#
import libs = libraylib%liba{raylib}

# Interactive GUI demos: do not run as automated tests.
#
exe{*}: test = false

# rlgl_standalone and raylib_opengl_interop use vendored GLFW/glad and are
# excluded everywhere below.
#
# DrawCube/DrawGrid/DrawSphere/DrawPlane/DrawLine3D are in rmodels, not
# rshapes -- examples rendering 3D geometry require module_models regardless
# of which category they live in.

# audio
#
for t: audio/c{* -rlgl_standalone -raylib_opengl_interop \
                   -audio_sound_positioning}
  ./: audio/exe{$name($t)}: include = ($config.libraylib.module_audio && \
                                        $config.libraylib.module_text  && \
                                        $config.libraylib.module_shapes)

# audio_sound_positioning renders a 3D scene (DrawGrid/DrawSphere from rmodels).
./: audio/exe{audio_sound_positioning}: \
  include = ($config.libraylib.module_audio && \
              $config.libraylib.module_text  && \
              $config.libraylib.module_shapes && \
              $config.libraylib.module_models)

# models
#
for t: models/c{* -rlgl_standalone -raylib_opengl_interop}
  ./: models/exe{$name($t)}: include = ($config.libraylib.module_models   && \
                                         $config.libraylib.module_text     && \
                                         $config.libraylib.module_shapes   && \
                                         $config.libraylib.module_textures)

# shapes
#
for t: shapes/c{* -rlgl_standalone -raylib_opengl_interop}
  ./: shapes/exe{$name($t)}: include = ($config.libraylib.module_shapes && \
                                         $config.libraylib.module_text)

# text
#
for t: text/c{* -rlgl_standalone -raylib_opengl_interop \
                  -text_3d_drawing}
  ./: text/exe{$name($t)}: include = ($config.libraylib.module_text   && \
                                       $config.libraylib.module_shapes)

# text_3d_drawing renders a 3D scene (DrawCubeV/DrawGrid from rmodels).
./: text/exe{text_3d_drawing}: \
  include = ($config.libraylib.module_text   && \
              $config.libraylib.module_shapes && \
              $config.libraylib.module_models)

# textures
#
for t: textures/c{* -rlgl_standalone -raylib_opengl_interop \
                     -textures_sprite_button                  \
                     -textures_sprite_explosion               \
                     -textures_framebuffer_rendering}
  ./: textures/exe{$name($t)}: include = ($config.libraylib.module_textures && \
                                           $config.libraylib.module_text     && \
                                           $config.libraylib.module_shapes)

# textures_sprite_button/explosion play audio on click (call InitAudioDevice).
for t: textures/c{textures_sprite_button textures_sprite_explosion}
  ./: textures/exe{$name($t)}: include = ($config.libraylib.module_textures && \
                                           $config.libraylib.module_text     && \
                                           $config.libraylib.module_shapes   && \
                                           $config.libraylib.module_audio)

# textures_framebuffer_rendering renders a 3D scene (DrawCube/DrawGrid from rmodels).
./: textures/exe{textures_framebuffer_rendering}: \
  include = ($config.libraylib.module_textures && \
              $config.libraylib.module_text     && \
              $config.libraylib.module_shapes   && \
              $config.libraylib.module_models)

# core: split on 3D geometry -- camera/picking examples use DrawCube/DrawGrid/
# DrawSphere from rmodels.
#
for t: core/c{* -rlgl_standalone -raylib_opengl_interop    \
                  -core_2d_camera_mouse_zoom                 \
                  -core_3d_camera_first_person               \
                  -core_3d_camera_fps                        \
                  -core_3d_camera_free                       \
                  -core_3d_camera_mode                       \
                  -core_3d_camera_split_screen               \
                  -core_3d_picking                           \
                  -core_vr_simulator                         \
                  -core_world_screen}
  ./: core/exe{$name($t)}: include = ($config.libraylib.module_text && \
                                       $config.libraylib.module_shapes)

for t: core/c{core_2d_camera_mouse_zoom                     \
               core_3d_camera_first_person                   \
               core_3d_camera_fps                            \
               core_3d_camera_free                           \
               core_3d_camera_mode                           \
               core_3d_camera_split_screen                   \
               core_3d_picking                               \
               core_vr_simulator                             \
               core_world_screen}
  ./: core/exe{$name($t)}: include = ($config.libraylib.module_text   && \
                                       $config.libraylib.module_shapes && \
                                       $config.libraylib.module_models)

# shaders: split on 3D geometry -- model-dependent examples load or draw 3D
# geometry via rmodels.
#
for t: shaders/c{* -rlgl_standalone -raylib_opengl_interop        \
                    -shaders_basic_lighting                         \
                    -shaders_basic_pbr -shaders_cel_shading        \
                    -shaders_custom_uniform                         \
                    -shaders_deferred_rendering                     \
                    -shaders_depth_rendering                        \
                    -shaders_depth_writing                          \
                    -shaders_fog_rendering                          \
                    -shaders_hybrid_rendering                       \
                    -shaders_lightmap_rendering                     \
                    -shaders_mesh_instancing                        \
                    -shaders_model_shader                           \
                    -shaders_normalmap_rendering                    \
                    -shaders_postprocessing                         \
                    -shaders_shadowmap_rendering                    \
                    -shaders_simple_mask                            \
                    -shaders_texture_tiling                         \
                    -shaders_vertex_displacement}
  ./: shaders/exe{$name($t)}: include = ($config.libraylib.module_text && \
                                          $config.libraylib.module_shapes)

for t: shaders/c{shaders_basic_lighting                            \
                   shaders_basic_pbr shaders_cel_shading            \
                   shaders_custom_uniform                           \
                   shaders_deferred_rendering                       \
                   shaders_depth_rendering                          \
                   shaders_depth_writing                            \
                   shaders_fog_rendering                            \
                   shaders_hybrid_rendering                         \
                   shaders_lightmap_rendering                       \
                   shaders_mesh_instancing                          \
                   shaders_model_shader                             \
                   shaders_normalmap_rendering                      \
                   shaders_postprocessing                           \
                   shaders_shadowmap_rendering                      \
                   shaders_simple_mask                              \
                   shaders_texture_tiling                           \
                   shaders_vertex_displacement}
  ./: shaders/exe{$name($t)}: include = ($config.libraylib.module_text   && \
                                          $config.libraylib.module_shapes && \
                                          $config.libraylib.module_models)

# others: embedded_files_loading plays audio (calls InitAudioDevice/PlaySound).
# rlgl_standalone and raylib_opengl_interop are not built (see above).
#
./: others/exe{embedded_files_loading}: include = ($config.libraylib.module_audio && \
                                                    $config.libraylib.module_text)

# Each category has a resources/ symlink so that CWD-relative "resources/..."
# paths in the upstream sources resolve correctly.
#
for t: dir{audio models shapes text textures core others shaders}
{
  d = $name($t)
  for t: $d/c{* -rlgl_standalone -raylib_opengl_interop}
  {
    n = $name($t)
    $d/exe{$n}: $t $libs $d/fsdir{resources}
  }
}
